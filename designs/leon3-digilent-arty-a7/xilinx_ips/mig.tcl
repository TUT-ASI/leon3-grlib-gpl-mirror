##################################################################
# CREATE IP mig
##################################################################

set mig_7series mig
create_ip -name mig_7series -vendor xilinx.com -library ip -module_name $mig_7series

write_mig_7series_mig  [file join [get_property IP_DIR [get_ips $mig_7series]] mig.prj]
set_property -dict { 
  CONFIG.XML_INPUT_FILE {mig.prj}
  CONFIG.RESET_BOARD_INTERFACE {Custom}
  CONFIG.MIG_DONT_TOUCH_PARAM {Custom}
  CONFIG.BOARD_MIG_PARAM {Custom}
} [get_ips $mig_7series]

generate_target all [get_ips $mig_7series]

